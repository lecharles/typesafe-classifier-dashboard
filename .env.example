# Vercel AI Gateway key (required). Get it from the Vercel dashboard -> AI.
AI_GATEWAY_API_KEY=

# Model used for classification. Free-tier friendly default.
CLASSIFIER_MODEL=anthropic/claude-3-haiku

# Optional: enables the live YouTube Data API v3 path in the YouTube analyzer.
# Without it, the analyzer uses the bundled sample dataset.
YOUTUBE_API_KEY=
