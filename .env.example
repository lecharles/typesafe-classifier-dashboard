# --- Real Jev (TypeSafe System One API) ---
# Two ways to reach the real Jev API — you only need ONE key:
#
# A) THROUGH THE VERCEL AI GATEWAY (recommended, one key for both backends):
#    - Set TYPESAFE_API_BASE to the gateway's TypeSafe-compatible surface
#    - Your existing AI_GATEWAY_API_KEY is used as the bearer token
#    - Real Jev = provider "jev"; the Claude emulation stays available as provider "gateway"
TYPESAFE_API_BASE=https://ai-gateway.vercel.sh/typesafe
#
# B) DIRECT API TYPESAFE.AI: leave TYPESAFE_API_BASE empty and set TYPESAFE_API_KEY
#    (create at https://console.typesafe.ai/keys). It takes precedence over the gateway key.
# TYPESAFE_API_KEY=
***
# Model/alias sent in System One requests. Unset = auto: "typesafe-ai/jev" through the
# gateway route, "jev-latest" through the direct route. Pin a version like
# "typesafe-ai/jev-1.14.0" for stable thresholds.
# JEV_MODEL=

# Default backend: "jev" | "gateway". If unset: "jev" when a real Jev route/key is
# available, otherwise "gateway". Can also be overridden per request with a
# "provider" field in the API body.
# CLASSIFIER_PROVIDER=jev

# --- Emulated primitives via Vercel AI Gateway (fallback backend) ---
# Vercel AI Gateway key. Get it from the Vercel dashboard -> AI.
AI_GATEWAY_API_KEY=
*** Model used for the emulated classification path. Free-tier friendly default.
CLASSIFIER_MODEL=anthropic/claude-3-haiku

# Optional: enables the live YouTube Data API v3 path in the YouTube analyzer.
# Without it, the analyzer uses the bundled sample dataset.
YOUTUBE_API_KEY=
